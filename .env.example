# Kafka MCP 服务配置示例
# 复制为 .env 后按实际环境修改：cp .env.example .env
# .env 已在 .gitignore 中，不会被提交

# ---- Kafka 集群连接 ----
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# 安全协议：PLAINTEXT / SASL_PLAINTEXT / SSL / SASL_SSL
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# SASL 认证（KAFKA_SECURITY_PROTOCOL 为 SASL_PLAINTEXT / SASL_SSL 时填写）
# KAFKA_SASL_MECHANISM=PLAIN
# KAFKA_SASL_USERNAME=your-username
# KAFKA_SASL_PASSWORD=your-password

# ---- 主题默认值 ----
DEFAULT_TOPIC_PARTITIONS=3
DEFAULT_TOPIC_REPLICATION_FACTOR=3
# 数据保留时长（毫秒），默认 7 天
DEFAULT_TOPIC_RETENTION_MS=604800000

# ---- 命名规则 ----
# 模型主题名：<前缀><model_id>.v<version>
MODEL_TOPIC_PREFIX=mcp.model.
# 消费者组名：<前缀><app_id>[.<model_id>.v<version>]
CONSUMER_GROUP_PREFIX=mcp.consumer.

# ---- HTTP API 服务 ----
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false

# ---- 日志与协议 ----
LOG_LEVEL=INFO
# 默认序列化格式：json / protobuf
DEFAULT_SERIALIZATION_FORMAT=json
